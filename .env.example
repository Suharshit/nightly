# The database that ingest, migrations, evals and the API use. The owner's .env points it at
# Supabase; a fresh clone can leave it on the local Docker Postgres.
DATABASE_URL=postgresql://nightly:nightly@localhost:5432/nightly
# Local Docker Postgres. pytest always uses this one and refuses a non-local DATABASE_URL.
DATABASE_URL_LOCAL=postgresql://nightly:nightly@localhost:5432/nightly
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
GROQ_API_KEY=
AGENT_MODEL=openai/gpt-oss-120b
EXTRACT_MODEL=openai/gpt-oss-20b
FALLBACK_MODEL=openai/gpt-oss-20b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
GMAIL_USER=
GMAIL_APP_PASSWORD=
APP_BASE_URL=http://localhost:3000
ADMIN_EMAILS=
CONTACT_URL=https://github.com/Suharshit/nightly
